{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated INVEST AI user profile metadata",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update (FieldValue.serverTimestamp())" }
      },
      "required": ["userId", "displayName", "createdAt", "updatedAt"]
    },
    "AgentInsight": {
      "title": "AgentInsight",
      "description": "Structured insight generated by Analista, Gestor, or Auditor agent",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "agentRole": { "type": "string", "enum": ["ANALISTA", "GESTOR", "AUDITOR"], "description": "Specialized agent role" },
        "ticker": { "type": "string", "description": "Target asset ticker" },
        "conclusion": { "type": "string", "enum": ["Comprar", "Manter", "Vender", "Aguardar"], "description": "Agent recommendation conclusion" },
        "confidence": { "type": "integer", "description": "Confidence score 0-100" },
        "thesis": { "type": "string", "description": "Investment thesis summary" },
        "sourceLabel": { "type": "string", "description": "Data source consulted" },
        "dataBase": { "type": "string", "description": "Reference base date" },
        "indicatorsSummary": { "type": "string", "description": "Key indicators summary" },
        "risksSummary": { "type": "string", "description": "Identified risks summary" },
        "scenariosSummary": { "type": "string", "description": "Optimistic, base, pessimistic scenarios" },
        "usedPersonalData": { "type": "boolean", "description": "Whether personal HHI summary was explicitly authorized" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["userId", "agentRole", "ticker", "conclusion", "confidence", "thesis", "usedPersonalData", "createdAt", "updatedAt"]
    },
    "ConsolidatedReport": {
      "title": "ConsolidatedReport",
      "description": "Executive management report aggregating Analista, Gestor, and Auditor insights",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "tickerFilter": { "type": "string", "description": "Ticker scope or GERAL" },
        "consensusConclusion": { "type": "string", "enum": ["Comprar", "Manter", "Vender", "Aguardar"], "description": "Aggregated consensus" },
        "averageConfidence": { "type": "integer", "description": "Average confidence across covered agents (0-100)" },
        "coveredAgentsCount": { "type": "integer", "description": "Number of agents represented (1-3)" },
        "analystSummary": { "type": "string", "description": "Latest Analista summary" },
        "gestorSummary": { "type": "string", "description": "Latest Gestor summary" },
        "auditorSummary": { "type": "string", "description": "Latest Auditor summary" },
        "combinedRisks": { "type": "string", "description": "Consolidated audit and HHI risks" },
        "totalEquityBrl": { "type": "number", "description": "Real portfolio equity snapshot in BRL" },
        "hhiScore": { "type": "number", "description": "Portfolio HHI concentration score" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["userId", "tickerFilter", "consensusConclusion", "averageConfidence", "coveredAgentsCount", "totalEquityBrl", "hhiScore", "createdAt", "updatedAt"]
    },
    "PortfolioSnapshot": {
      "title": "PortfolioSnapshot",
      "description": "Cloud backup metadata of imported real portfolio snapshot",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "fileName": { "type": "string", "description": "Imported CSV/XLSX filename" },
        "fileType": { "type": "string", "description": "CSV, XLSX, or MANUAL" },
        "recordCount": { "type": "integer", "description": "Count of active positions" },
        "totalEquityBrl": { "type": "number", "description": "Total real equity in BRL" },
        "cashBalanceBrl": { "type": "number", "description": "Cash balance in BRL" },
        "hhiScore": { "type": "number", "description": "HHI score" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["userId", "fileName", "fileType", "recordCount", "totalEquityBrl", "cashBalanceBrl", "hhiScore", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-user profile document"
    },
    "/users/{userId}/agent_insights/{insightId}": {
      "schema": { "$ref": "#/entities/AgentInsight" },
      "description": "Persisted AI insights from Analista, Gestor, and Auditor"
    },
    "/users/{userId}/consolidated_reports/{reportId}": {
      "schema": { "$ref": "#/entities/ConsolidatedReport" },
      "description": "Saved consolidated executive management reports"
    },
    "/users/{userId}/portfolio_snapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/PortfolioSnapshot" },
      "description": "Cloud-synced real portfolio snapshot summaries"
    }
  }
}
